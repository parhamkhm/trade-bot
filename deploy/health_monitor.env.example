# Template for /opt/tbot/health-monitor.env  (read by tbot-health-monitor.service).
#
#   sudo install -m 0600 -o root -g root deploy/health_monitor.env.example /opt/tbot/health-monitor.env
#   sudo nano /opt/tbot/health-monitor.env        # fill in the two values below
#
# The real file is root-only (mode 600) and must NEVER be committed, pasted into chat, or
# mounted into a container. Plain KEY=value lines: no quotes, no spaces around "=", no "export".

# --- secrets (both required) ---
# Bot token from BotFather, looks like 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TBOT_TELEGRAM_BOT_TOKEN=
# Your numeric chat id; find it with scripts/telegram_get_chat_id.py (see SERVER_SETUP.md section 19)
TBOT_TELEGRAM_CHAT_ID=

# --- optional tuning (non-secret; leave commented to use the defaults) ---
#TBOT_MONITOR_INTERVAL_S=60              # seconds between checks (min 5)
#TBOT_MONITOR_DISK_MAX_PCT=80            # alert when a filesystem is more than this % used
#TBOT_MONITOR_REPEAT_HOURS=6             # re-send a reminder for an unresolved problem this often
#TBOT_MONITOR_BACKUP_MAX_AGE_HOURS=36    # backup older than this counts as failed
#TBOT_MONITOR_HEARTBEAT_MAX_AGE_S=300    # recorder heartbeat file older than this counts as stale
#TBOT_MONITOR_RESOLVE_CYCLES=2           # clear checks in a row before a RESOLVED message (anti-flap)
#TBOT_MONITOR_CONFIRM_CYCLES=2           # consecutive bad checks before a container/disk ALERT (anti-flap)
#TBOT_MONITOR_DISK_CLEAR_MARGIN=2        # a disk alert clears only this many points below the limit
#TBOT_MONITOR_DISK_PATHS=/,/var/lib/docker,/var/backups/tbot
#TBOT_MONITOR_LBANK_STATUS_FILE=/var/backups/tbot/lbank/status.json
#TBOT_MONITOR_TRADES_BACKUP_DIR=/var/backups/tbot/trades
#TBOT_MONITOR_STATE_DIR=/var/lib/tbot-health-monitor

# --- optional dead-man switch (non-secret URL, but never share it publicly; leave unset to disable) ---
# A free service like healthchecks.io gives you a URL to GET on a schedule; it alerts YOU if the
# pings stop, which covers the one failure this monitor cannot report itself: the whole server dying.
# Parham decides later whether to set this up; the monitor works fine without it.
#TBOT_DEADMAN_URL=
