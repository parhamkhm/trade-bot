# Host-side Telegram HEALTH-ALERT monitor (send-only). Separate from every recorder container:
# the containers receive no Telegram secret and know nothing about it.
#
# Type=simple + an internal 60 s loop (not a timer): de-duplication, "RESOLVED" and reminder state
# live in one process, a slow `docker inspect` can never overlap itself, and Restart=always brings it
# back after any crash. See deploy/SERVER_SETUP.md section 19.
#
# Runs from its own pinned, root-owned copy, /opt/tbot/monitor-run (same pattern as the LBank
# recorder's /opt/tbot/lbank-run, see section 18.1): pulling `main` into the main checkout must never
# change what this unit runs underneath it without a deliberate, reviewed update step.
#
# Install (root):
#   cp -r /opt/tbot/trade-bot /opt/tbot/monitor-run   # first time only; see SERVER_SETUP.md 19.0
#   install -m 0644 /opt/tbot/monitor-run/deploy/systemd/tbot-health-monitor.service /etc/systemd/system/
#   install -m 0600 -o root -g root /opt/tbot/monitor-run/deploy/health_monitor.env.example \
#       /opt/tbot/health-monitor.env   # then edit
#   systemctl daemon-reload && systemctl enable --now tbot-health-monitor
#
# Runs the stdlib-only monitor with the system python3; it needs neither uv nor a virtualenv.
[Unit]
Description=tbot health monitor (Telegram health alerts, send-only)
Documentation=file:///opt/tbot/monitor-run/deploy/SERVER_SETUP.md
After=network-online.target docker.service
Wants=network-online.target
# Deliberately no Requires=docker.service: the monitor must keep running, and alert, when docker is down.

[Service]
Type=simple
# root is needed to run `docker inspect` and read docker volume mountpoints. The hardening below keeps
# the rest of the filesystem read-only and the process unable to gain privileges.
User=root
EnvironmentFile=/opt/tbot/health-monitor.env
Environment=PYTHONPATH=/opt/tbot/monitor-run/src
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/tbot/monitor-run
ExecStart=/usr/bin/python3 /opt/tbot/monitor-run/scripts/run_health_monitor.py
Restart=always
RestartSec=10
# Exit status 2 = missing/invalid token or chat id: restarting every 10 s cannot fix that.
RestartPreventExitStatus=2
TimeoutStopSec=15

StateDirectory=tbot-health-monitor
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tbot-health-monitor
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0077
MemoryMax=128M

[Install]
WantedBy=multi-user.target
