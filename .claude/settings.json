{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 uv run --no-project --quiet --offline --python 3.12 python -P \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_order_code.py\" || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
