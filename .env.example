# Copy to .env on the server. NEVER commit .env. Values below are intentionally empty.

# --- Tabdeal API (phase 0-5: READ-ONLY key, no withdrawal permission, IP-whitelisted) ---
TBOT_TABDEAL_API_KEY=
TBOT_TABDEAL_API_SECRET=

# --- Telegram (phase 5+) ---
TBOT_TELEGRAM_BOT_TOKEN=
TBOT_TELEGRAM_CHAT_ID=

# --- Runtime ---
# Which config file under config/ to load: default | backtest | paper | live
TBOT_CONFIG=default
# Hard safety switch. Real orders additionally require config phase >= 6.
TBOT_LIVE_TRADING=false
